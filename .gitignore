.playwright-profile/
.playwright-mcp/

# Scraped output — the archive. Never tracked.
Google AI Studio/
Deepseek Chat/
Kimi Chat/
ChatGPT/
Claude/
Gemini/
Grok/
output/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Temp files
/tmp/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs and run state
*.log
*.pid
.reclaim_manifest.json
.last_sync_*.json

# Pre-v1.0.0 standalone scrapers (local reference only — never public)
legacy/

# One-off endpoint probes / debug scripts from development (local only)
dev-probes/

# Developer-oriented docs (local only — public repo shows product docs only)
docs/status_and_plan/

# Environment files (never commit secrets)
.env
.env.*
